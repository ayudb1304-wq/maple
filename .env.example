# --- SkyTonight environment ---
# Copy to .env.local and fill in. Never commit .env.local.

# Geoapify Static Maps API key. SERVER ONLY — must never reach the client
# bundle, a client-visible URL, or logs. Free tier: 3,000 credits/day.
# Get one at https://myprojects.geoapify.com
GEOAPIFY_KEY=

# Dodo Payments hosted checkout link for Pro.
# If unset, the Pro buttons render as "Coming soon" instead of linking out.
DODO_CHECKOUT_URL=

# Canonical public URL, used for OG/card absolute URLs and the outgoing
# User-Agent string. No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
